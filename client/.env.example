# 이 파일을 .env.local로 복사해서 값을 채운다 (.env.local은 git에 올라가지 않는다)
# Supabase 대시보드 → Project Settings → API Keys
# publishable 키만 넣는다. secret / service_role 키는 절대 넣지 않는다
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# 멀티플레이 중계 서버 (server/ 폴더). 비워 두면 멀티플레이 없이 혼자 노는 모드로 동작한다
# 로컬: cd server && ./gradlew bootRun
VITE_RELAY_URL=ws://localhost:8081/ws
